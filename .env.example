DATABASE_URL=postgresql://app_user:app_dev_password@localhost:5433/platform
DIRECT_URL=postgresql://platform:platform_dev_password@localhost:5433/platform
REDIS_URL=redis://localhost:6390
PLATFORM_ROOT_DOMAIN=localhost
APP_URL=http://localhost:3000
LOG_LEVEL=info
AUTH_SECRET=change-me-to-32+-random-chars
AUTH_TRUST_HOST=true
S3_ENDPOINT=http://localhost:9100
S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=videos
S3_ACCESS_KEY=S3RVER
S3_SECRET_KEY=S3RVER
S3_FORCE_PATH_STYLE=true
PLATFORM_VAST_TAG_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
INTERNAL_TOKEN=change-me

# This server public IPs (comma separated). Lets apex custom domains verify with A/AAAA records instead of a CNAME.
PLATFORM_IPS=
# Local dev infra ports (scripts/dev-infra.ts)
POSTGRES_PORT=5433
DEV_REDIS_PORT=6390
DEV_S3_PORT=9100

# IndexNow (Bing, Yandex...): any 8-128 chars [A-Za-z0-9-]. Leave empty to disable. Every site serves it at /<key>.txt automatically.
INDEXNOW_KEY=
# Content scanning (optional). ClamAV daemon for malware; webhook for a moderation / hash-matching provider you contract.
# clamd must allow big streams: StreamMaxLength 5G in clamd.conf.
CLAMD_HOST=
CLAMD_PORT=3310
SCAN_WEBHOOK_URL=
SCAN_WEBHOOK_TOKEN=
# true = never publish a video while no scanner is configured
SCANNER_REQUIRED=false
# Automatic captions (Premium). {input} = 16 kHz mono wav, {output} = path without extension (tool writes {output}.vtt)
WHISPER_COMMAND=
WHISPER_LANGUAGE=en
# Shown on the platform's own Contact / Privacy / DMCA pages
PLATFORM_CONTACT_EMAIL=
