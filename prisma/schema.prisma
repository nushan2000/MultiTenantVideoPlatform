// Shared database, shared schema. Every tenant-owned table carries `tenantId`
// and is protected by Row-Level Security (see prisma/migrations/*_rls).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: the non-superuser `app_user` role (RLS is enforced).
  url       = env("DATABASE_URL")
  // Migrations run as the schema owner.
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ContentCategory {
  GENERAL
  ADULT
}

enum Role {
  OWNER
  ADMIN
  EDITOR
}

enum DomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
}

enum VideoStatus {
  UPLOADING
  IMPORTING
  PROCESSING
  READY
  FAILED
  BLOCKED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum IngestMethod {
  DIRECT
  URL
}

enum AdMode {
  PLATFORM
  CUSTOM
}

enum ReportType {
  ABUSE
  DMCA
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum CommentStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

// ---------------------------------------------------------------- global tables

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String?
  isSuperAdmin  Boolean      @default(false)
  suspendedAt   DateTime?
  termsAcceptedAt DateTime
  createdAt     DateTime     @default(now())
  memberships   Membership[]
}

model Plan {
  id            String   @id @default(cuid())
  key           String   @unique // "free" | "premium" — entitlements() keys off this
  name          String
  stripePriceId String?
  tenants       Tenant[]
  subscriptions Subscription[]
}

// ---------------------------------------------------------------- tenant tables

model Tenant {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  planId          String
  status          TenantStatus    @default(ACTIVE)
  contentCategory ContentCategory @default(GENERAL)
  templateId      String          @default("classic-grid")
  theme           Json            @default("{}")
  features        Json            @default("{}")
  seo             Json            @default("{}") // site-wide SEO settings (see src/lib/seo.ts)
  profile         Json            @default("{}") // business details used by the legal pages (see src/lib/pages/profile.ts)
  logoUrl         String?
  faviconUrl      String?
  createdAt       DateTime        @default(now())

  plan          Plan           @relation(fields: [planId], references: [id])
  memberships   Membership[]
  subscriptions Subscription[]
  domains       CustomDomain[]
  videos        Video[]
  renditions    VideoRendition[]
  categories    Category[]
  pages         Page[]
  adConfig      AdConfig?
  storageUsage  StorageUsage?
  reports       Report[]
  auditLogs     AuditLog[]
  comments      Comment[]
  likes         VideoLike[]
  playlists     Playlist[]
  playlistItems PlaylistItem[]
  videoStats    VideoStatDaily[]
  bandwidth     BandwidthUsage[]
}

model Membership {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  role     Role

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  providerCustomerId   String?
  providerSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
}

model CustomDomain {
  id                String       @id @default(cuid())
  tenantId          String
  hostname          String       @unique
  status            DomainStatus @default(PENDING)
  verificationToken String
  tlsStatus         String       @default("none")
  createdAt         DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Category {
  id       String @id @default(cuid())
  tenantId String
  name     String
  slug     String
  seo      Json   @default("{}")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  videos Video[]

  @@unique([tenantId, slug])
}

model Video {
  id                String       @id @default(cuid())
  tenantId          String
  categoryId        String?
  title             String
  description       String?
  status            VideoStatus  @default(UPLOADING)
  visibility        Visibility   @default(PRIVATE)
  durationSec       Int?
  hlsPath           String?
  thumbnailPath     String?
  sizeBytes         BigInt?
  views             Int          @default(0)
  featured          Boolean      @default(false)
  seo               Json         @default("{}") // per-video SEO overrides
  tags              String[]     @default([]) // slugified tags -> /tag/<tag> pages
  transcript        String?      // plain text shown on the watch page (SEO text content)
  captions          Json         @default("[]") // [{lang,label,path}] WebVTT files in storage
  chapters          Json         @default("[]") // [{start,title}] key moments
  ingestMethod      IngestMethod
  sourceUrl         String?
  importProgress    Int          @default(0) // percent; live byte counts live in Redis
  failureReason     String?
  rightsConfirmedAt DateTime?
  likes             Int          @default(0) // denormalised count of VideoLike rows
  publishAt         DateTime?    // scheduled publishing: the maintenance worker makes the video PUBLIC at this time
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  renditions    VideoRendition[]
  reports       Report[]
  comments      Comment[]
  videoLikes    VideoLike[]
  playlistItems PlaylistItem[]
  stats         VideoStatDaily[]

  @@index([tenantId, status, createdAt])
  @@index([publishAt])
  @@index([tags], type: Gin)
}

model VideoRendition {
  id           String @id @default(cuid())
  tenantId     String
  videoId      String
  height       Int // 360 | 720 | 1080
  bitrateKbps  Int
  playlistPath String
  sizeBytes    BigInt @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  video  Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, height])
}

model AdConfig {
  id          String  @id @default(cuid())
  tenantId    String  @unique
  mode        AdMode  @default(PLATFORM)
  vastTagUrl  String?
  htmlSnippet String?
  enabled     Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model StorageUsage {
  id            String @id @default(cuid())
  tenantId      String @unique
  bytesUsed     BigInt @default(0)
  bytesReserved BigInt @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Report {
  id            String       @id @default(cuid())
  tenantId      String
  videoId       String
  type          ReportType
  reason        String
  reporterEmail String?
  reporterIp    String?
  status        ReportStatus @default(OPEN)
  createdAt     DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  video  Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// tenantId is nullable for platform-level actions; those rows are visible
// only to the platform (RLS bypass) context.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  target    String?
  ip        String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// Storefront pages. SYSTEM pages (about, contact, privacy, terms, dmca, ...) exist by default as generated text and
// become a row only when the owner customises them (systemKey set). CUSTOM pages are owner-created (systemKey null).
model Page {
  id        String   @id @default(cuid())
  tenantId  String
  slug      String
  title     String
  content   String   @default("") // Markdown (sanitised to HTML on render)
  systemKey String?
  published Boolean  @default(true)
  inFooter  Boolean  @default(true)
  position  Int      @default(0)
  seo       Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@unique([tenantId, systemKey])
  @@index([tenantId, published])
}

// ---------------------------------------------------------------- engagement, curation, analytics, bandwidth

// Anonymous viewers (no accounts on storefronts): comments are moderated, spam-limited and hash their IP, never store it raw.
model Comment {
  id         String        @id @default(cuid())
  tenantId   String
  videoId    String
  authorName String
  body       String
  status     CommentStatus @default(PENDING)
  ipHash     String?
  createdAt  DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  video  Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([videoId, status, createdAt])
}

// One like per (video, voter). voterHash = HMAC(ip + user agent), so the same visitor can't like twice but we never keep the IP.
model VideoLike {
  id        String   @id @default(cuid())
  tenantId  String
  videoId   String
  voterHash String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  video  Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, voterHash])
  @@index([tenantId])
}

model Playlist {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  slug        String
  description String?
  published   Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  PlaylistItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, published, position])
}

model PlaylistItem {
  id         String @id @default(cuid())
  tenantId   String
  playlistId String
  videoId    String
  position   Int    @default(0)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId, position])
}

// Per-video, per-day counters for the analytics tab. Written with raw upserts (never touches Video.updatedAt).
model VideoStatDaily {
  id           String   @id @default(cuid())
  tenantId     String
  videoId      String
  day          DateTime @db.Date
  views        Int      @default(0)
  watchSeconds Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  video  Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, day])
  @@index([tenantId, day])
}

// Bytes served per tenant per calendar month (month = "YYYY-MM"). Live counter is in Redis; the maintenance worker persists it here.
model BandwidthUsage {
  id       String @id @default(cuid())
  tenantId String
  month    String
  bytes    BigInt @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
}
